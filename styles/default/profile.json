    "marginPct": 7
  },
  "graphics": {
    "titleCard": false,
    "titleCardSec": 2.0,
    "progressBar": false,
    "progressBarColor": "#FFE01A"
  },
  "broll": { "ratio_pct": 0, "avg_clip_sec": 1.8 },
  "audio": { "lufs": -14 },
