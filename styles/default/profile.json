    "yPct": 68,
    "maxWordsOnScreen": 3,
    "fill": "#FFFFFF",
    "highlight": "#FFE01A",
    "highlightBox": null,
    "stroke": { "color": "#000000", "widthPct": 0.35 },
    "shadow": "0 6px 18px rgba(0,0,0,0.45)",
    "enter": "pop",
